PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://controle-de-gastos-ekvr.vercel.app

# Banco local / MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=controle_gastos
DB_PORT=3306
DB_SSL=false

# Supabase (use junto com a chave de serviço para substituir o MySQL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nome alternativo aceito pelo servidor:
# SUPABASE_SECRET_KEY=

# JWT (obrigatório em produção; mínimo de 32 caracteres)
JWT_SECRET=gere_uma_string_aleatoria_longa_aqui
