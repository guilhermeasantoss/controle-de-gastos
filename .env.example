# Copie este arquivo para .env e preencha os valores
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=controle_gastos
PORT=3000

# Gere com: node -e "require('crypto').randomBytes(48).toString('hex')|console.log"
JWT_SECRET=gere_uma_string_aleatoria_longa_aqui

# Origens permitidas (separadas por vírgula) — deixe vazio para aceitar todas (não recomendado em produção)
ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com
